<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Mobile" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#020617</item>
        <item name="android:statusBarColor">#020617</item>
        <item name="android:navigationBarColor">#020617</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:colorAccent">#22D3EE</item>
    </style>

    <style name="Theme.Mobile.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#020617</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_transparent_icon</item>
        <item name="windowSplashScreenAnimationDuration">0</item>
        <item name="postSplashScreenTheme">@style/Theme.Mobile</item>
    </style>
</resources>
